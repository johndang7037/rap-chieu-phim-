  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .seat { transition: all 0.2s ease; cursor: pointer; user-select: none; }
    .seat:hover:not(.occupied) { transform: scale(1.15); }
    .seat-selected { background-color: #10b981 !important; color: #ffffff !important; font-weight: bold; }
    .seat-occupied { background-color: #1e293b !important; color: #475569 !important; border: 1px solid #334155; cursor: not-allowed !important; opacity: 0.45; }
  </style>
</head>
